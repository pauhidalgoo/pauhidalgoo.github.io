[
  {{- range $index, $page := where site.RegularPages "Params.noindex" "ne" true }}
  {{- if $index }},{{ end }}
  {
    "title": {{ $page.Title | jsonify }},
    "permalink": {{ $page.RelPermalink | jsonify }},
    "summary": {{ ($page.Summary | plainify) | jsonify }},
    "content": {{ ($page.Plain | htmlUnescape) | jsonify }},
    "section": {{ $page.Section | jsonify }},
    "date": {{ if $page.Date.IsZero }}""{{ else }}{{ $page.Date.Format "2006-01-02" | jsonify }}{{ end }},
    "type": {{ ($page.Params.type_label | default $page.Type) | jsonify }},
    "tags": {{ ($page.Params.tags | default slice) | jsonify }}
  }
  {{- end }}
]
